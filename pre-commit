#!/usr/bin/env bash

# Flutter pre-commit hook

cd "$(git rev-parse --show-toplevel)" || exit 1

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'


echo ""
echo -e "${BLUE}====================================${NC}"
echo -e "${BLUE}🔍 PRE-COMMIT HOOK STARTED${NC}"
echo -e "${BLUE}====================================${NC}"
echo ""


STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '\.dart$' \
  | grep -vE '\.(g|freezed|gr|config|mocks)\.dart$')


if [ -z "$STAGED_FILES" ]; then
  echo -e "${YELLOW}⚠️ No staged Dart files found. Skipping.${NC}"
  exit 0
fi


echo -e "${BLUE}📌 Dart files to check:${NC}"
echo "$STAGED_FILES"
echo ""


UNSTAGED_FILES=$(git diff --name-only)


echo -e "${BLUE}🎨 Checking formatting...${NC}"


FORMAT_FAILED=0

while IFS= read -r file; do

  [ -f "$file" ] || continue

  echo -e "${BLUE}➡️ Checking:${NC} $file"

  if dart format --output=none --set-exit-if-changed "$file" >/dev/null 2>&1; then
    echo -e "${GREEN}✅ Already formatted${NC}"
  else

    if echo "$UNSTAGED_FILES" | grep -qxF "$file"; then

      echo -e "${RED}❌ $file needs formatting and has unstaged changes.${NC}"
      FORMAT_FAILED=1

    else

      echo -e "${YELLOW}✨ Formatting $file...${NC}"

      dart format "$file"

      git add "$file"

      echo -e "${GREEN}✅ Formatted and re-staged${NC}"

    fi
  fi

done <<< "$STAGED_FILES"


if [ "$FORMAT_FAILED" -ne 0 ]; then
  echo -e "${RED}❌ Commit aborted. Fix formatting first.${NC}"
  exit 1
fi


echo ""
echo -e "${BLUE}🔎 Running flutter analyze...${NC}"
echo ""


flutter analyze


if [ $? -ne 0 ]; then
  echo ""
  echo -e "${RED}❌ Analyze failed. Commit aborted.${NC}"
  exit 1
fi


echo ""
echo -e "${GREEN}✅ All checks passed.${NC}"
echo -e "${GREEN}🎉 PRE-COMMIT HOOK FINISHED${NC}"
echo ""

exit 0