#!/usr/bin/env bash

# Flutter pre-push hook

cd "$(git rev-parse --show-toplevel)" || exit 1

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo ""
echo -e "${BLUE}====================================${NC}"
echo -e "${BLUE}🚀 PRE-PUSH HOOK STARTED${NC}"
echo -e "${BLUE}====================================${NC}"
echo ""

if [ ! -d "test" ]; then
  echo -e "${YELLOW}⚠️  No test directory found, skipping tests.${NC}"
  exit 0
fi

echo -e "${BLUE}📂 Project root:${NC} $(pwd)"
echo ""

if [ "${RUN_BUILD_RUNNER:-0}" = "1" ]; then
  echo -e "${BLUE}⚙️  Running build_runner...${NC}"

  dart run build_runner build --delete-conflicting-outputs

  if [ $? -ne 0 ]; then
    echo -e "${RED}❌ build_runner failed. Push aborted.${NC}"
    exit 1
  fi

  echo -e "${GREEN}✅ build_runner completed.${NC}"
  echo ""
fi


echo -e "${BLUE}🧪 Running Flutter tests...${NC}"
echo ""

flutter test

if [ $? -ne 0 ]; then
  echo ""
  echo -e "${RED}❌ Tests failed. Push aborted.${NC}"
  exit 1
fi


echo ""
echo -e "${GREEN}✅ All tests passed successfully.${NC}"
echo -e "${GREEN}🚀 PRE-PUSH HOOK FINISHED${NC}"
echo ""

exit 0